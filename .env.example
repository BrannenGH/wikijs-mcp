# Copy to .env and fill in every secret before starting the stack.

# Public Wiki.js URL as served by Caddy.
WIKI_PUBLIC_URL=https://wiki.example.com

# Bind only to localhost when Caddy runs on this host. Use 192.168.1.10 if
# Caddy is on another host and must reach these ports over the LAN.
WIKI_BIND_ADDR=127.0.0.1
WIKI_UI_PORT=3001
MCP_BIND_ADDR=127.0.0.1
MCP_PORT=3002
MCP_RESOURCE_URL=https://wiki.example.com/mcp

POSTGRES_DB=wikijs
POSTGRES_USER=wikijs
POSTGRES_PASSWORD=change-me

# Example: https://keycloak.example.com/realms/YOUR_REALM
KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/YOUR_REALM

# Keycloak confidential client for browser SSO through oauth2-proxy.
KEYCLOAK_UI_CLIENT_ID=wikijs-ui
KEYCLOAK_UI_CLIENT_SECRET=change-me

# Leave unset. Claude and similar MCP clients connect via Keycloak dynamic
# client registration, and those tokens don't carry a custom audience claim,
# so enforcing one here rejects every real client. Only set this if your
# Keycloak realm is configured to stamp that audience onto every issued
# token regardless of client (e.g. via a default client scope mapper).
KEYCLOAK_MCP_AUDIENCE=

# Generate with:
# openssl rand -hex 16
OAUTH2_PROXY_COOKIE_SECRET=change-me-32-byte-secret

# Generate in Wiki.js after the initial admin setup.
WIKIJS_API_TOKEN=change-me

# Optional: pin after testing the pulled version.
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:latest
